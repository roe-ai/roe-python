#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

cd "$ROOT_DIR"

uv run --group codegen openapi-python-client generate \
  --path openapi/openapi.yml \
  --config openapi/config.yaml \
  --meta none \
  --output-path "$TMP_DIR/generated" \
  --overwrite

rm -rf src/roe/_generated
mv "$TMP_DIR/generated" src/roe/_generated
